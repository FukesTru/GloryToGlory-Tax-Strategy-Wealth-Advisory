# Copy to .env.local and fill in before deploying.

# Public site URL (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://glorytoglory.com

# Google Analytics 4 measurement ID. Placeholder "G-XXXXXXXXXX" is rendered until this is set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: lets the build pull the Unsplash photos listed in scripts/unsplash.json.
# Create a free app at https://unsplash.com/developers and copy its Access Key.
# Never commit a real key; .env.local is gitignored.
UNSPLASH_ACCESS_KEY=

# Optional: where the contact form posts (Formspree, Zapier, Make, Resend webhook...).
# When empty, submissions are logged server-side only.
CONTACT_WEBHOOK_URL=
